# orchestra: copy to .env, fill in, never commit .env
ORCHESTRA_PROVIDER=claude_code     # mock | claude_code | anthropic | openai
ORCHESTRA_BASELINE=medium          # tier the ledger's counterfactual runs on (small | medium | large)

# claude_code: headless `claude -p` with your own Claude login, no key needed
ORCHESTRA_SMALL=claude-haiku-4-5
ORCHESTRA_MEDIUM=claude-sonnet-5
ORCHESTRA_LARGE=claude-opus-5
# CLAUDE_BIN=claude

# anthropic: same three models, needs a key
ANTHROPIC_API_KEY=

# openai-compatible (OpenAI, OpenRouter, Gemini OpenAI endpoint, claude-code-api on the VPS)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# prices for models not in orchestra/config.py, USD per million tokens "input,output"
# ORCHESTRA_PRICE_GPT_5_6_LUNA=0.20,1.20
